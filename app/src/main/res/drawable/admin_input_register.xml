<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/admin_surface_raised" />
            <stroke android:width="2dp" android:color="@color/admin_action" />
            <corners android:radius="12dp" />
            <padding android:left="14dp" android:top="0dp" android:right="14dp" android:bottom="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/admin_surface_raised" />
            <stroke android:width="1dp" android:color="@color/admin_outline" />
            <corners android:radius="12dp" />
            <padding android:left="14dp" android:top="0dp" android:right="14dp" android:bottom="0dp" />
        </shape>
    </item>
</selector>
