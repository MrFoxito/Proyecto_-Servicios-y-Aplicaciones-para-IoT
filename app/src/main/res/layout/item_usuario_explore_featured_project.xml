<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="232dp"
    android:layout_height="250dp"
    android:layout_marginRight="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/explore_surface"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="@color/explore_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="174dp">

            <ImageView
                android:id="@+id/ivExploreFeaturedImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Imagen del proyecto"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvExploreFeaturedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/explore_badge_bg"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="150dp"
                android:paddingLeft="9dp"
                android:paddingTop="5dp"
                android:paddingRight="9dp"
                android:paddingBottom="5dp"
                android:textColor="@color/explore_badge_text"
                android:fontFamily="@font/manrope_bold"
                android:textSize="10sp"
                android:visibility="gone" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="9dp"
                android:layout_marginRight="9dp"
                android:background="@drawable/explore_favorite_button_bg"
                android:contentDescription="Favorito no disponible"
                android:padding="7dp"
                android:src="@drawable/ic_explore_favorite" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvExploreFeaturedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/explore_text_primary"
            android:fontFamily="@font/manrope_bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvExploreFeaturedLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/explore_text_secondary"
            android:fontFamily="@font/manrope_regular"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
