<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/ad_bottom_nav_bg"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- Inicio -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="#9AA3AF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="INICIO"
                android:textColor="#9AA3AF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Proyectos -->
        <LinearLayout
            android:id="@+id/navProyectos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_projects"
                app:tint="#9AA3AF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="PROYECTOS"
                android:textColor="#9AA3AF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asesores -->
        <LinearLayout
            android:id="@+id/navAsesores"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_advisors"
                app:tint="#9AA3AF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ASESORES"
                android:textColor="#9AA3AF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Reportes -->
        <LinearLayout
            android:id="@+id/navReportes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_reports"
                app:tint="#9AA3AF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="REPORTES"
                android:textColor="#9AA3AF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Perfil (Activo) -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/ad_pill_active"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_profile_outline"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="PERFIL"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Profile Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp">
                
                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        app:cardBackgroundColor="#FAFAFA"
                        app:cardCornerRadius="60dp"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        app:contentPadding="10dp"
                        app:strokeColor="#B08B45"
                        app:strokeWidth="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/sa_profile_admin" />
                    </com.google.android.material.card.MaterialCardView>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_circle_white"
                        android:padding="2dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="#8A6D3B"/>
                </FrameLayout>
                
                <TextView
                    android:id="@+id/tvAdminProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estate Admin"
                    android:textColor="#0B1A24"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>
                    
                <TextView
                    android:id="@+id/tvAdminProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="admin@editorialestate.com"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Datos Personales -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#8A6D3B"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="DATOS PERSONALES"
                    android:textColor="#8A6D3B"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_search_bar"
                android:backgroundTint="#F5F5F5"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <!-- Nombres -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOMBRES Y APELLIDOS"
                    android:textColor="#9AA3AF"
                    android:textSize="8sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvAdminProfileFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Administrador Editorial"
                    android:textColor="#0B1A24"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Row: Documento / Nacimiento -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DOCUMENTO"
                            android:textColor="#9AA3AF"
                            android:textSize="8sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DNI 45678912-K"
                            android:textColor="#0B1A24"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NACIMIENTO"
                            android:textColor="#9AA3AF"
                            android:textSize="8sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15/05/1985"
                            android:textColor="#0B1A24"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Teléfono -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TELÉFONO DE CONTACTO"
                    android:textColor="#9AA3AF"
                    android:textSize="8sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvAdminProfilePhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+52 55 1234 5678"
                    android:textColor="#0B1A24"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Domicilio -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOMICILIO"
                    android:textColor="#9AA3AF"
                    android:textSize="8sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Av. Luxury Boulevard, Suite 400,\nCDMX"
                    android:textColor="#0B1A24"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Inmobiliaria -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_dialog_map"
                    app:tint="#8A6D3B"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="INMOBILIARIA"
                    android:textColor="#8A6D3B"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_bar"
                android:backgroundTint="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="32dp">
                
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:background="@drawable/bg_btn_dark_blue"
                    android:padding="8dp"
                    app:tint="@color/white"/>
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERTENECIENTE A"
                        android:textColor="#9AA3AF"
                        android:textSize="8sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvAdminProfileCompany"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The Editorial Estate"
                        android:textColor="#0B1A24"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="#9AA3AF"/>
            </LinearLayout>

            <!-- Buttons -->
            <Button
                android:id="@+id/btnEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_dark_blue"
                android:backgroundTint="#163143"
                android:text="Editar Perfil"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:drawableStart="@android:drawable/ic_menu_edit"
                android:drawablePadding="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:gravity="center"
                app:backgroundTint="@null"
                android:layout_marginBottom="16dp"/>
                
            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_light_grey"
                android:text="Cerrar Sesión"
                android:textColor="#BA1A1A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:drawableStart="@android:drawable/ic_lock_power_off"
                android:drawableTint="#BA1A1A"
                android:drawablePadding="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:gravity="center"
                app:backgroundTint="@null"
                android:layout_marginBottom="32dp"/>

            <!-- Footer Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCESO NIVEL ADMINISTRADOR"
                    android:textColor="#8A6D3B"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_gold"
                    android:backgroundTint="#EFE9DD"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginBottom="12dp"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestión de activos de lujo y curaduría editorial\ninmobiliaria."
                    android:textColor="#9AA3AF"
                    android:textSize="9sp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
