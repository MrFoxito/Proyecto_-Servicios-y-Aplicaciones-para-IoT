<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="136dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_project"
    android:padding="14dp">

    <TextView
        android:id="@+id/tipCTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tipo C"
        android:textColor="#163143"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:background="@drawable/bg_tag_venta"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="DISPONIBLE"
        android:textColor="#0C6D14"
        android:textSize="9sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/rowFeaturesC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tipCTitle"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="60 m²"
            android:textColor="#6A737B"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="39 habs"
            android:textColor="#6A737B"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/montoCTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/rowFeaturesC"
        android:layout_marginTop="10dp"
        android:text="Monto total:"
        android:textColor="#163143"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_alignBaseline="@id/montoCTitle"
        android:layout_marginStart="104dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="310,000 USD"
        android:textColor="#163143"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sepCTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/montoCTitle"
        android:layout_marginTop="10dp"
        android:text="SEPARACIÓN:"
        android:textColor="#8A6D3B"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_alignBaseline="@id/sepCTitle"
        android:layout_marginStart="104dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="1,400 USD"
        android:textColor="#163143"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/rowFeaturesC"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="🗑"
        android:textColor="#C0C7CF"
        android:textSize="12sp" />

</RelativeLayout>
