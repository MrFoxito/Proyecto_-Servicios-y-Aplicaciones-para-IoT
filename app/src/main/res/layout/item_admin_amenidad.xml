<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp"
    android:background="@drawable/admin_detail_amenity_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <ImageView
        android:id="@+id/ivAmenity"
        android:layout_width="18dp"
        android:layout_height="18dp" />

    <TextView
        android:id="@+id/tvAmenityTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:textColor="#32373C"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnDeleteAmenity"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Eliminar amenidad"
        android:padding="7dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#9AA3AF" />

</LinearLayout>
