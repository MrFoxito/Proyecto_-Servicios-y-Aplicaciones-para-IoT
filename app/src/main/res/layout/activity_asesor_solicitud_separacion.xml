<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/topSolicitud"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#F8F9FA">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_as_close"
            app:tint="#0B1D2A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:text="SOLICITUD DE SEPARACION"
            android:textColor="#0B1D2A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Contenido -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topSolicitud"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Imagen destacada -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <ImageView
                    android:id="@+id/imgProperty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/as_project_placeholder"
                    android:contentDescription="Imagen de la propiedad" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="22dp"
                    android:layout_marginEnd="38dp"
                    android:background="@drawable/as_chip_dark"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="PROPIEDAD DESTACADA"
                    android:textColor="#BFC9CE"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Tarjeta de información superior -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="-64dp"
                android:background="@drawable/as_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ID DE RESERVA"
                            android:textColor="#9AA3AF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSolReservaId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="#EE-2024-0982"
                            android:textColor="#0B1D2A"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Fecha de solicitud (añadida) -->
                        <TextView
                            android:id="@+id/txtSolFecha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Solicitado: 12 Oct 2026"
                            android:textColor="#9AA3AF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Badge de estado (ID añadido) -->
                    <TextView
                        android:id="@+id/txtSolStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/as_status_pending"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="PENDIENTE"
                        android:textColor="#0B1D2A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:background="#EEF0F2" />

                <!-- Descripción del estado (ID añadido) -->
                <TextView
                    android:id="@+id/txtSolEstadoDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Estado: Pendiente de Aprobacion"
                    android:textColor="#746D4A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Datos del solicitante -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/as_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="22dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sa_profile_asesor_1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DATOS DEL SOLICITANTE"
                        android:textColor="#9AA3AF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSolCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Julian Thorne"
                        android:textColor="#0B1D2A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSolClienteSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="j.thorne@luxuryrealestate.com"
                        android:textColor="#68727B"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Datos del inmueble -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/as_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DATOS DEL INMUEBLE"
                    android:textColor="#9AA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSolProyecto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Penthouse Altos del Bosque"
                    android:textColor="#0B1D2A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSolPropiedad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tipo 1"
                    android:textColor="#68727B"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Montos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/as_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRECIO TOTAL"
                        android:textColor="#9AA3AF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSolPrecioTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="$4,250,000"
                        android:textColor="#0B1D2A"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/as_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MONTO SEPARACIÓN"
                        android:textColor="#9AA3AF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSolMontoSeparacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="$15,000"
                        android:textColor="#8F7E00"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Comprobante -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/as_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_circle_beige"
                    android:padding="6dp"
                    android:src="@drawable/ic_as_lock" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Comprobante de transferencia"
                    android:textColor="#0B1D2A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_as_external" />
            </LinearLayout>

            <!-- Botones de acción -->
            <TextView
                android:id="@+id/btnAprobarPagoSolicitud"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/as_button_dark"
                android:gravity="center"
                android:text="APROBAR PAGO"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRechazarSolicitud"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="RECHAZAR SOLICITUD"
                android:textColor="#B45858"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
