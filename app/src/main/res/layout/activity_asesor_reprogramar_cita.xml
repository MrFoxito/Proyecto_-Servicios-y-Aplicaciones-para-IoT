<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_as_back"
        app:tint="#0B1D2A" />

    <TextView
        android:id="@+id/titleReprogramar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="Reprogramar Cita"
        android:textColor="#0B1D2A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/titleReprogramar"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="244dp"
                android:background="@drawable/as_card"
                android:elevation="3dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="136dp">

                    <ImageView
                        android:id="@+id/imgPropiedadReprogramar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/as_property_09" />

                    <TextView
                        android:id="@+id/txtProyectoTag"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/as_chip_dark"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="PROYECTO"
                        android:textColor="#F0D782"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtPropiedadNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nombre del\nProyecto"
                            android:textColor="#0B1D2A"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPropiedadUbicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Ubicación"
                            android:textColor="#68727B"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtCitaStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/as_status_green"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="CONFIRMADA"
                        android:textColor="#0A2D3A"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/as_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <TextView
                    android:id="@+id/txtAvatarCliente"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_beige"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="#0B1D2A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNombreCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nombre Cliente"
                        android:textColor="#0B1D2A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtInfoCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Información del cliente"
                        android:textColor="#53606A"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/as_card_soft"
                    android:padding="10dp"
                    android:src="@drawable/ic_as_calendar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/as_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="FECHA ACTUAL"
                            android:textColor="#9A8A6E"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtFechaActualValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="--"
                            android:textColor="#0B1D2A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="NUEVA FECHA"
                            android:textColor="#9A8A6E"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/editNuevaFecha"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/as_input"
                            android:paddingHorizontal="12dp"
                            android:hint="Seleccionar fecha"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="#0B1D2A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:inputType="date" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/as_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="HORA ACTUAL"
                            android:textColor="#9A8A6E"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtHoraActualValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="--"
                            android:textColor="#0B1D2A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="NUEVA HORA"
                            android:textColor="#9A8A6E"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/editNuevaHora"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/as_input"
                            android:paddingHorizontal="12dp"
                            android:hint="Seleccionar hora"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="#0B1D2A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:inputType="time" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="MOTIVO DE REPROGRAMACION"
                android:textColor="#9A8A6E"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editMotivoReprogramacion"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/as_input_white"
                android:gravity="top"
                android:hint="Escribe el motivo aquí..."
                android:padding="16dp"
                android:textColor="#2D363D"
                android:textSize="13sp"
                android:inputType="textMultiLine" />

            <TextView
                android:id="@+id/btnConfirmarReprogramacion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/as_button_dark"
                android:gravity="center"
                android:text="Confirmar Reprogramacion"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCancelarReprogramacion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/as_card_soft"
                android:gravity="center"
                android:text="Cancelar"
                android:textColor="#2B343B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="18dp"
                android:gravity="center"
                android:text="Al confirmar, se actualizara la agenda del asesor y se notificara al cliente automaticamente."
                android:textColor="#9AA3AF"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
