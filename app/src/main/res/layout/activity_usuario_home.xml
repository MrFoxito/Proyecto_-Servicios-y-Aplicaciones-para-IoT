<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <ScrollView
        android:id="@+id/userScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="108dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/userContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/space_24"
            android:paddingTop="52dp"
            android:paddingRight="@dimen/space_24"
            android:paddingBottom="@dimen/space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextRoleH1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_title"
                        android:textColor="@color/app_text_primary" />

                    <TextView
                        style="@style/TextRoleParagraph"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:maxLines="2"
                        android:text="@string/home_subtitle"
                        android:textColor="@color/app_text_secondary" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnExploreNotifications"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@drawable/user_profile_icon_bg"
                    android:contentDescription="@string/cd_notifications"
                    android:padding="12dp"
                    android:src="@drawable/ic_user_notification"
                    app:tint="@color/app_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/user_search_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <ImageView
                    android:layout_width="@dimen/icon_search"
                    android:layout_height="@dimen/icon_search"
                    android:contentDescription="@string/cd_search"
                    android:src="@drawable/ic_user_search"
                    app:tint="@color/app_text_soft" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:text="@string/home_search_hint"
                    android:textColor="@color/app_text_soft"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="@dimen/icon_nav"
                    android:layout_height="@dimen/icon_nav"
                    android:contentDescription="@string/cd_filter"
                    android:src="@drawable/ic_user_filter"
                    app:tint="@color/app_text_soft" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextRoleH2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_featured_title"
                        android:textColor="@color/app_text_primary" />

                    <TextView
                        style="@style/TextRoleParagraph"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_featured_subtitle"
                        android:textColor="@color/app_text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSeeAllProperties"
                    style="@style/TextRoleH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/space_4"
                    android:text="@string/home_see_all"
                    android:textAllCaps="true"
                    android:textColor="@color/app_accent_gold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingRight="@dimen/space_8"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/featuredPrimaryCard"
                        android:layout_width="@dimen/featured_card_width"
                        android:layout_height="@dimen/featured_card_height"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/home_featured_property"
                                android:scaleType="centerCrop"
                                android:src="@drawable/user_featured_house" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/space_16"
                                android:layout_marginTop="14dp"
                                android:background="@drawable/user_badge_bg"
                                android:paddingLeft="@dimen/space_12"
                                android:paddingTop="@dimen/space_4"
                                android:paddingRight="@dimen/space_12"
                                android:paddingBottom="@dimen/space_4"
                                android:text="@string/home_badge_limited"
                                android:textColor="@color/app_badge_text"
                                android:textSize="12sp" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <Space
                        android:layout_width="@dimen/space_16"
                        android:layout_height="1dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/featuredSecondaryCard"
                        android:layout_width="@dimen/featured_card_width"
                        android:layout_height="@dimen/featured_card_height"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/home_popular_property_2"
                            android:scaleType="centerCrop"
                            android:src="@drawable/user_popular_2" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                style="@style/TextRoleH2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/home_popular_title"
                android:textColor="@color/app_text_primary" />

            <TextView
                style="@style/TextRoleParagraph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_popular_subtitle"
                android:textColor="@color/app_text_secondary" />

            <LinearLayout
                android:id="@+id/popularRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="122dp"
                    android:layout_height="122dp"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_popular_property_1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_popular_1" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPopularLabel1"
                        style="@style/TextRoleH3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_popular_label_1"
                        android:textColor="@color/app_accent_gold" />

                    <TextView
                        android:id="@+id/tvPopularTitle1"
                        style="@style/TextRoleH2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_popular_property_1"
                        android:textColor="@color/app_text_primary" />

                    <TextView
                        android:id="@+id/tvPopularMeta1"
                        style="@style/TextRoleCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/home_popular_meta_1"
                        android:textColor="@color/app_text_muted" />

                    <TextView
                        android:id="@+id/tvPopularPrice1"
                        style="@style/TextRoleH2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_popular_price_1"
                        android:textColor="@color/app_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/popularRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="122dp"
                    android:layout_height="122dp"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_popular_property_2"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_popular_2" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPopularLabel2"
                        style="@style/TextRoleH3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_popular_label_2"
                        android:textColor="@color/app_accent_gold" />

                    <TextView
                        android:id="@+id/tvPopularTitle2"
                        style="@style/TextRoleH2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_popular_property_2"
                        android:textColor="@color/app_text_primary" />

                    <TextView
                        android:id="@+id/tvPopularMeta2"
                        style="@style/TextRoleCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/home_popular_meta_2"
                        android:textColor="@color/app_text_muted" />

                    <TextView
                        android:id="@+id/tvPopularPrice2"
                        style="@style/TextRoleH2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_popular_price_2"
                        android:textColor="@color/app_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TextRoleH2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/property_list_title"
                android:textColor="@color/app_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHomeFirebaseProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/userBottomNavInclude"
        layout="@layout/view_usuario_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>
