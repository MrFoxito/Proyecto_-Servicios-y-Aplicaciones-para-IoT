<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/explore_bg">

    <!-- The catalogue owns the only vertical scroll. Header and search remain fixed. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHomeExploreCatalog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingLeft="@dimen/space_24"
        android:paddingTop="188dp"
        android:paddingRight="@dimen/space_24"
        android:paddingBottom="96dp"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/layoutExploreFixedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/space_24"
        android:paddingTop="52dp"
        android:paddingRight="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextRoleH1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_extrabold"
                    android:text="Encuentra tu lugar"
                    android:textColor="@color/explore_text_primary"
                    android:textSize="26sp" />

                <TextView
                    style="@style/TextRoleParagraph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:text="Explora los mejores proyectos inmobiliarios"
                    android:textColor="@color/explore_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnExploreNotifications"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/explore_header_icon_bg"
                android:contentDescription="@string/cd_notifications"
                android:padding="11dp"
                android:src="@drawable/ic_user_notification"
                app:tint="@color/explore_text_primary" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHomeProjectSearch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:clickable="true"
            android:focusable="true"
            android:transitionName="project_search_bar"
            app:cardBackgroundColor="@color/explore_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/explore_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="18dp"
                android:paddingRight="18dp">

                <ImageView
                    android:layout_width="@dimen/icon_search"
                    android:layout_height="@dimen/icon_search"
                    android:contentDescription="@string/cd_search"
                    android:src="@drawable/ic_user_search"
                    app:tint="@color/explore_text_primary" />

                <TextView
                    android:id="@+id/inputHomeProjectSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:contentDescription="Buscar proyectos"
                    android:fontFamily="@font/manrope_semibold"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:text="Buscar proyectos"
                    android:textColor="@color/explore_text_primary"
                    android:textSize="14sp" />

                <FrameLayout
                    android:id="@+id/btnHomeQrScan"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/explore_qr_button_bg"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="Escanear QR"
                        android:src="@drawable/ic_user_qr"
                        app:tint="@color/explore_text_primary" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <include
        android:id="@+id/userBottomNavInclude"
        layout="@layout/view_usuario_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>
