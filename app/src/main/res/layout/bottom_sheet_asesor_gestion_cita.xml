<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/as_bottom_action_shadow"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestionar cita"
        android:textColor="#0B1D2A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:text="Elige una acción para actualizar la atención."
        android:textColor="#68727B"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnReprogramarCita"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/as_card_soft"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:text="Reprogramar cita"
        android:textColor="#2B343B"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnMarcarAtendida"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/as_status_green"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:text="Marcar como atendida"
        android:textColor="#0A2D3A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnMarcarNoAsistio"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/as_status_pending"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:text="Marcar como no asistió"
        android:textColor="#0A2D3A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="#E0E4E7" />

    <TextView
        android:id="@+id/btnCancelarCita"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/as_card_soft"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:text="Cancelar cita"
        android:textColor="#9B1C1C"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
