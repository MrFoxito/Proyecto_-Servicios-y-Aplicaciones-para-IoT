<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sa_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#F6F7F9"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnOpenMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="menu"
            android:src="@drawable/ic_sa_menu_uniform" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Inmobiliarias"
            android:textColor="#072B41"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivHeaderProfile"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/sa_avatar_circle_mask"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/sa_profile_admin" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="22dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="GESTION DE INMOBILIARIAS"
                android:textColor="#6F7784"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Registrar Nueva\nInmobiliaria"
                android:textColor="#072B41"
                android:textSize="30sp"
                android:textStyle="bold" />
                
            <!-- Área para subir foto simulada -->
            <LinearLayout
                android:id="@+id/layoutUploadPhoto"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/sa_input_register"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                
                <ImageView
                    android:id="@+id/ivInmobiliariaPhoto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#7A828E"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Subir Foto"
                    android:textColor="#7A828E"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.12"
                android:text="NOMBRE DE LA INMOBILIARIA"
                android:textColor="#1D2B3A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/sa_input_register"
                android:hint="Ej. Elite Real Estate"
                android:paddingHorizontal="14dp"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.12"
                android:text="DESCRIPCION"
                android:textColor="#1D2B3A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/sa_input_register"
                android:hint="Breve descripción de la empresa..."
                android:paddingHorizontal="14dp"
                android:paddingTop="14dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:textSize="16sp" />
                
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:background="#E5E7EB" />
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Administrador a Cargo"
                android:textColor="#072B41"
                android:textSize="18sp"
                android:textStyle="bold" />
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Se le enviará una invitación a este correo para que gestione la inmobiliaria."
                android:textColor="#6F7784"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.12"
                android:text="CORREO ELECTRONICO DEL ADMIN"
                android:textColor="#1D2B3A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/sa_input_register"
                android:hint="admin@agencia.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSaveAdmin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#2D3B48"
                android:elevation="0dp"
                android:letterSpacing="0.05"
                android:text="REGISTRAR INMOBILIARIA E INVITAR"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
