<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <RelativeLayout
        android:id="@+id/rlTopNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FAFAFA"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#163143" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/topContentNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rlTopNav"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Notificaciones"
            android:textColor="#163143"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/filtroSeparaciones" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_pill_active" android:gravity="center" android:paddingHorizontal="18dp" android:text="Separaciones" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/filtroPagos" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_pill_inactive" android:gravity="center" android:paddingHorizontal="18dp" android:text="Pagos" android:textColor="#8C7A65" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topContentNotificaciones"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingBottom="32dp" />

    <TextView
        android:id="@+id/tvSinNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_below="@id/topContentNotificaciones"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_report_card"
        android:gravity="center"
        android:text="No hay notificaciones para este filtro"
        android:textColor="#6B7280"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

</RelativeLayout>
