<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <RelativeLayout
        android:id="@+id/topEditarPerfil"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#F8F9FA">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_as_back"
            app:tint="#0B1D2A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:text="Editar Perfil"
            android:textColor="#0B1D2A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topEditarPerfil"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp">

            <ImageView
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:background="@drawable/bg_circle_beige"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/sa_profile_asesor_1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/as_chip_dark"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Cambiar Foto"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="DATOS PERSONALES"
                android:textColor="#9B8500"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEditarNombre"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/as_input_white"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:hint="Nombre completo"
                android:inputType="textPersonName"
                android:textColor="#0B1D2A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEditarEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/as_input_white"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:textColor="#0B1D2A"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtEditarTelefono"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/as_input_white"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:hint="Teléfono"
                android:inputType="phone"
                android:textColor="#0B1D2A"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="PERFIL PROFESIONAL"
                android:textColor="#9B8500"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEditarCargo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/as_input_white"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:hint="Cargo o Rol"
                android:inputType="text"
                android:textColor="#0B1D2A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEditarBio"
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/as_input_white"
                android:gravity="top"
                android:lineSpacingExtra="4dp"
                android:padding="18dp"
                android:hint="Biografía"
                android:inputType="textMultiLine"
                android:textColor="#4D5962"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="ASIGNACION ACTUAL"
                android:textColor="#9B8500"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/as_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="82dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/as_property_08" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Residencias Aura"
                        android:textColor="#0B1D2A"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="The Heights, Madrid"
                        android:textColor="#68727B"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnGuardarPerfilAsesor"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/as_button_dark"
                android:gravity="center"
                android:text="Guardar Cambios"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnCancelarEditarPerfilAsesor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Cancelar"
                android:textColor="#0B1D2A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
