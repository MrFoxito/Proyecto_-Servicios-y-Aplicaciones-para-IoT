<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <RelativeLayout
        android:id="@+id/topEditarPerfil"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/app_bg">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_as_back"
            app:tint="@color/app_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:text="Editar Perfil"
            android:textColor="@color/app_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topEditarPerfil"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp">

            <!-- Avatar -->
            <RelativeLayout
                android:layout_width="132dp"
                android:layout_height="132dp">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:background="@drawable/bg_circle_beige"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sa_profile_asesor_1" />

                <Button
                    android:id="@+id/btnCambiarFoto"
                    style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:checkable="true"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    app:icon="@drawable/ic_user_edit"
                    app:iconTint="@color/white"
                    android:backgroundTint="@color/sa_dark"/>
            </RelativeLayout>

            <!-- Campos de solo lectura -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="DATOS PERSONALES"
                android:textColor="@color/app_accent_gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/lyNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="Nombres"
                app:boxStrokeColor="@color/app_separator"
                app:boxBackgroundColor="@null"
                app:helperTextEnabled="true"
                app:helperText="No editable">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/app_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/lyApellido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="Apellidos"
                app:boxStrokeColor="@color/app_separator"
                app:boxBackgroundColor="@null"
                app:helperTextEnabled="true"
                app:helperText="No editable">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/app_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Correo (solo lectura) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="Correo electrónico"
                app:boxStrokeColor="@color/app_separator"
                app:boxBackgroundColor="@null"
                app:helperTextEnabled="true"
                app:helperText="No editable">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/app_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Teléfono (editable) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="Teléfono"
                app:boxStrokeColor="@color/app_separator"
                app:hintTextColor="@color/app_text_muted"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="@color/app_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/app_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Descripción / Biografía (editable) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="SOBRE MÍ"
                android:textColor="@color/app_accent_gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="Descripción profesional"
                app:boxStrokeColor="@color/app_separator"
                app:hintTextColor="@color/app_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:maxLines="6"
                    android:textColor="@color/app_text_primary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botones -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarPerfilAsesor"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                style="@style/ThemeOverlay.Material3Expressive.Button.Filled"
                android:text="Guardar Cambios"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarEditarPerfilAsesor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                style="@style/ThemeOverlay.Material3Expressive.Button.Outlined"
                android:gravity="center"
                android:backgroundTint="@color/white"
                android:text="Cancelar"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>