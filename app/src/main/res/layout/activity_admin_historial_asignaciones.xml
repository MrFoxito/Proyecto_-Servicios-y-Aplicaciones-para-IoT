<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <RelativeLayout
        android:id="@+id/rlTopNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FAFAFA"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#0B1A24" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/topHistoryContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rlTopNav"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historial de asignaciones"
            android:textColor="#0B1A24"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:background="#163143" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_search_bar"
            android:backgroundTint="#F5F5F5"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvResumenHistorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#163143"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUltimaAsignacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorialAsignaciones"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topHistoryContent"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp" />

    <TextView
        android:id="@+id/tvHistorialVacio"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_below="@id/topHistoryContent"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_card_project"
        android:gravity="center"
        android:padding="18dp"
        android:text="Todavia no hay asignaciones guardadas localmente."
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</RelativeLayout>
