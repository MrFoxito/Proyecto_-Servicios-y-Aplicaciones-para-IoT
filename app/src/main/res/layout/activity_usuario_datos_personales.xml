<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/personalDataRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="108dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/space_24"
            android:paddingTop="@dimen/space_24"
            android:paddingRight="@dimen/space_24"
            android:paddingBottom="@dimen/space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBackPersonalData"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="@drawable/user_profile_icon_bg"
                    android:contentDescription="@string/cd_back"
                    android:padding="@dimen/space_12"
                    android:src="@drawable/ic_user_back"
                    android:tint="@color/app_text_primary" />

                <TextView
                    style="@style/TextRoleH2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_16"
                    android:layout_weight="1"
                    android:text="@string/profile_detail_personal_title" />
            </LinearLayout>

            <TextView
                style="@style/TextRoleParagraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/profile_detail_personal_subtitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:background="@drawable/user_surface_card_bg"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    style="@style/TextRoleH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_section_summary_label"
                    android:textColor="@color/app_accent_gold" />

                <TextView
                    style="@style/TextRoleH2"
                    android:id="@+id/tvPersonalSummaryName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/profile_personal_name_value" />

                <TextView
                    android:id="@+id/tvPersonalSummaryContact"
                    style="@style/TextRoleCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/profile_personal_pref_contact_value" />
            </LinearLayout>

            <TextView
                style="@style/TextRoleH3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/profile_personal_name_label"
                android:textColor="@color/app_text_muted" />

            <EditText
                android:id="@+id/etPersonalName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_lg"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/user_search_bg"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:text="@string/profile_personal_name_value"
                android:textAppearance="@style/TextRoleParagraph"
                android:textColor="@color/app_text_primary" />

            <TextView
                style="@style/TextRoleH3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/profile_personal_email_label"
                android:textColor="@color/app_text_muted" />

            <EditText
                android:id="@+id/etPersonalEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_lg"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/user_search_bg"
                android:inputType="textEmailAddress"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:text="@string/profile_personal_email_value"
                android:textAppearance="@style/TextRoleParagraph"
                android:textColor="@color/app_text_primary" />

            <TextView
                style="@style/TextRoleH3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/profile_personal_phone_label"
                android:textColor="@color/app_text_muted" />

            <EditText
                android:id="@+id/etPersonalPhone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_lg"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/user_search_bg"
                android:inputType="phone"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:text="@string/profile_personal_phone_value"
                android:textAppearance="@style/TextRoleParagraph"
                android:textColor="@color/app_text_primary" />

            <TextView
                style="@style/TextRoleH3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/profile_personal_city_label"
                android:textColor="@color/app_text_muted" />

            <EditText
                android:id="@+id/etPersonalCity"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_lg"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/user_search_bg"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:text="@string/profile_personal_city_value"
                android:textAppearance="@style/TextRoleParagraph"
                android:textColor="@color/app_text_primary" />

            <TextView
                style="@style/TextRoleH3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/profile_personal_pref_contact_label"
                android:textColor="@color/app_text_muted" />

            <EditText
                android:id="@+id/etPersonalPrefContact"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_lg"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/user_search_bg"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:text="@string/profile_personal_pref_contact_value"
                android:textAppearance="@style/TextRoleParagraph"
                android:textColor="@color/app_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePersonalData"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_md"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/user_detail_primary_button_bg"
                android:backgroundTint="@android:color/transparent"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:text="@string/profile_personal_save_button"
                android:textColor="@color/white"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="@dimen/radius_sm"
                app:icon="@drawable/ic_user_check_circle"
                app:iconGravity="textEnd"
                app:iconPadding="@dimen/space_8"
                app:iconTint="@color/white"
                app:rippleColor="#22000000"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/userBottomNavInclude"
        layout="@layout/view_usuario_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>
