<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Panel de acciones fijo en la parte inferior -->
    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/as_bottom_action_shadow"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- Estado + badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Estado de la cita"
                android:textColor="#68727B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalleStatus"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/as_status_green"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="CONFIRMADA"
                android:textColor="#0A2D3A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botón principal -->
        <TextView
            android:id="@+id/btnRegistrarSeparacionDetalle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/as_button_dark"
            android:gravity="center"
            android:text="Registrar Separación"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Botón secundario -->
        <TextView
            android:id="@+id/btnReprogramarCita"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/as_card_soft"
            android:gravity="center"
            android:text="Reprogramar Cita"
            android:textColor="#2B343B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/panelAsistencia"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMarcarAtendida"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/as_status_green"
                android:gravity="center"
                android:text="Atendida"
                android:textColor="#0A2D3A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMarcarNoAsistio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/as_status_pending"
                android:gravity="center"
                android:text="No asistio"
                android:textColor="#0A2D3A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCancelarCita"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/as_card_soft"
            android:gravity="center"
            android:text="Cancelar cita"
            android:textColor="#9B1C1C"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Botón back -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:elevation="2dp"
        android:src="@drawable/ic_as_back"
        app:tint="#0B1D2A" />

    <!-- Contenido scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/actionPanel"
        android:layout_below="@id/btnBack"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Hero image con overlay de proyecto + nombre propiedad -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/imgDetallePropiedad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/as_property_01" />

                <!-- Gradiente inferior para legibilidad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_gravity="bottom"
                    android:background="#B0000000"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/txtDetalleProyecto"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/as_chip_dark"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="INMOBILIARIA HORIZONTE"
                        android:textColor="#F0D782"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDetallePropiedad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Penthouse Altos del Bosque"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Badge estado sobre la imagen -->
                <TextView
                    android:id="@+id/txtDetalleStatusImg"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="end|top"
                    android:layout_margin="12dp"
                    android:background="@drawable/as_status_green"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="CONFIRMADA"
                    android:textColor="#0A2D3A"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Cliente: avatar + nombre + acciones rápidas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtDetalleAvatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_beige"
                    android:gravity="center"
                    android:text="AV"
                    android:textColor="#0B1D2A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtDetalleCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alicia Velarde"
                        android:textColor="#0B1D2A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

<!--                    <TextView-->
<!--                        android:id="@+id/txtDetalleClienteTipo"-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_marginTop="2dp"-->
<!--                        android:text="Cliente · Portafolio Activo"-->
<!--                        android:textColor="#63707A"-->
<!--                        android:textSize="12sp" />-->
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnLlamar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/as_card_soft"
                    android:src="@drawable/ic_as_phone"
                    app:tint="#0A2D3A" />

                <ImageButton
                    android:id="@+id/btnMensaje"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/as_card_soft"
                    android:src="@drawable/ic_as_message"
                    app:tint="#0A2D3A" />
            </LinearLayout>

            <!-- Tarjetas fecha + hora -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/as_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FECHA PROGRAMADA"
                        android:textColor="#9A8A6E"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDetalleFecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="4 May, 2026"
                        android:textColor="#0B1D2A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDetalleDia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Lunes"
                        android:textColor="#9AA3AF"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/as_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HORA DE LA CITA"
                        android:textColor="#9A8A6E"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDetalleHora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="08:30 AM"
                        android:textColor="#0B1D2A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>

            <!-- Divider con label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="UBICACIÓN"
                android:textColor="#9A8A6E"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Ubicación -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/as_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtDetalleDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Penthouse Altos del Bosque"
                        android:textColor="#0B1D2A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDetalleSubdireccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Av. del Bosque 120, Piso 18"
                        android:textColor="#68727B"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="NAVEGAR"
                    android:textColor="#8F7E00"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Miniatura mapa -->
<!--            <ImageView-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="130dp"-->
<!--                android:layout_marginTop="8dp"-->
<!--                android:scaleType="centerCrop"-->
<!--                android:src="@drawable/as_property_07" />-->

            <!-- Divider + Notas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="NOTAS DE LA CITA"
                android:textColor="#9A8A6E"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/as_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtDetalleNotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="Sin notas registradas."
                    android:textColor="#2B343B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnEditarNota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/as_chip_light"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="+ Editar nota"
                    android:textColor="#746D4A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Historial de interacciones -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="HISTORIAL DE CONTACTO"
                android:textColor="#9A8A6E"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Historial de interacciones (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistorialCita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false" />

            <!-- Spacer inferior -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
