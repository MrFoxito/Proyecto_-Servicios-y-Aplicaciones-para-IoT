<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_16"
    android:background="@drawable/user_surface_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_card_min_height"
    android:orientation="horizontal"
    android:padding="@dimen/space_12">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/list_card_image_size"
        android:layout_height="@dimen/list_card_image_size"
        app:cardCornerRadius="@dimen/radius_sm"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/app_separator">

        <ImageView
            android:id="@+id/ivPropertyItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPropertyItemLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/app_brand_navy"
            android:fontFamily="@font/manrope_bold"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvPropertyItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/app_text_primary"
            android:fontFamily="@font/manrope_bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvPropertyItemLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/app_text_secondary"
            android:fontFamily="@font/manrope_regular"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPropertyItemTypology"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/app_text_secondary"
            android:fontFamily="@font/manrope_regular"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvPropertyItemPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/app_text_primary"
            android:fontFamily="@font/manrope_bold"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
