<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_16"
    android:background="@drawable/user_surface_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_card_min_height"
    android:orientation="horizontal"
    android:padding="@dimen/space_12">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/list_card_image_size"
        android:layout_height="@dimen/list_card_image_size"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivPropertyItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPropertyItemLabel"
            style="@style/TextRoleH3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/app_accent_gold" />

        <TextView
            android:id="@+id/tvPropertyItemTitle"
            style="@style/TextRoleH2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" />

        <TextView
            android:id="@+id/tvPropertyItemLocation"
            style="@style/TextRoleCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" />

        <TextView
            android:id="@+id/tvPropertyItemTypology"
            style="@style/TextRoleCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/app_text_secondary" />

        <TextView
            android:id="@+id/tvPropertyItemPrice"
            style="@style/TextRoleH2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textColor="@color/app_text_primary" />
    </LinearLayout>
</LinearLayout>
