<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <RelativeLayout
        android:id="@+id/rlTopNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FAFAFA"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_user_back"
            app:tint="#082D42" />
    </RelativeLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/rlTopNav"
        android:background="#EAECEF" />

    <LinearLayout
        android:id="@+id/bottomActionsDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FAFAFA"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="22dp">

        <Button
            android:id="@+id/btnEditarProyecto"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:background="@drawable/admin_detail_dark_pill"
            android:drawableStart="@drawable/ic_user_edit"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:text="Editar Proyecto"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:drawableTint="@color/white" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomActionsDetalle"
        android:layout_below="@id/topDivider"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:text="Ver Proyecto"
                android:textColor="#082D42"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="MATERIAL VISUAL"
                android:textColor="#1A3444"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_project"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/sa_profile_admin" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_project"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/sa_profile_admin" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_card_project"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/sa_profile_admin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOMBRE DEL PROYECTO"
                android:textColor="#4C5A66"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="Catalina Sky View"
                android:textColor="#24465C"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESCRIPCIÓN"
                android:textColor="#4C5A66"
                android:textSize="9sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_card_project"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="16dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="5dp"
                    android:text="Un hito arquitectónico diseñado para redefinir el lujo urbano. Catalina Sky View ofrece una experiencia de vida elevada con vistas panorámicas de 360 grados, acabados de mármol importado y una estructura de cristal de alto desempeño. Cada unidad ha sido curada para maximizar la luz natural y el flujo espacial, creando un santuario de calma sobre el pulso de la ciudad."
                    android:textColor="#4E5760"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="UBICACION"
                android:textColor="#082D42"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIRECCIÓN EXACTA"
                android:textColor="#4C5A66"
                android:textSize="9sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_project"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_location"
                    app:tint="#D1D8DE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Avenida de las Palmas 450"
                    android:textColor="#6C737A"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CIUDAD / REGIÓN"
                android:textColor="#4C5A66"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_card_project"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="Lima - Perú"
                android:textColor="#6C737A"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/admin_detail_map_bg"
                android:clipToOutline="true">

                <View
                    android:layout_width="220dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="#50C4D59A"
                    android:rotation="-18" />

                <View
                    android:layout_width="200dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="#30FFFFFF"
                    android:rotation="-18"
                    android:translationY="-24dp" />

                <View
                    android:layout_width="220dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="#24FFFFFF"
                    android:rotation="-18"
                    android:translationY="22dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="170dp"
                    android:layout_gravity="center"
                    android:background="#26FFFFFF"
                    android:rotation="60" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="170dp"
                    android:layout_gravity="center"
                    android:background="#26FFFFFF"
                    android:rotation="60"
                    android:translationX="-52dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="170dp"
                    android:layout_gravity="center"
                    android:background="#26FFFFFF"
                    android:rotation="60"
                    android:translationX="52dp" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="@drawable/admin_detail_pin_halo" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_location"
                    app:tint="#F7B236" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="ESTADO COMERCIAL"
                android:textColor="#082D42"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_card_project"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="En planos"
                    android:textColor="#464D53"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/admin_detail_dark_pill"
                    android:gravity="center"
                    android:text="En preventa"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="En venta"
                    android:textColor="#464D53"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="TIPOLOGIA"
                android:textColor="#082D42"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_project"
                android:padding="14dp">

                <TextView
                    android:id="@+id/detailTitleA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo A"
                    android:textColor="#153448"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/admin_detail_status_green"
                    android:gravity="center"
                    android:text="DISPONIBLE"
                    android:textColor="#0B6B0E"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/detailRowA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detailTitleA"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_admin_ruler" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/admin_detail_stat_chip"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="70 m²"
                            android:textColor="#68707A"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_admin_bed" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/admin_detail_stat_chip"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="20 habs"
                            android:textColor="#68707A"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/montoALabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detailRowA"
                    android:layout_marginTop="12dp"
                    android:text="Monto total:"
                    android:textColor="#183447"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/montoALabel"
                    android:layout_marginStart="104dp"
                    android:text="350,000 USD"
                    android:textColor="#4F5962"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sepALabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/montoALabel"
                    android:layout_marginTop="14dp"
                    android:text="SEPARACIÓN:"
                    android:textColor="#9A7817"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/sepALabel"
                    android:layout_marginStart="104dp"
                    android:text="1,500 USD"
                    android:textColor="#4F5962"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_project"
                android:padding="14dp">

                <TextView
                    android:id="@+id/detailTitleB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo B"
                    android:textColor="#153448"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/admin_detail_status_green"
                    android:gravity="center"
                    android:text="DISPONIBLE"
                    android:textColor="#0B6B0E"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/detailRowB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detailTitleB"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_admin_ruler" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/admin_detail_stat_chip"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="80 m²"
                            android:textColor="#68707A"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_admin_bed" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/admin_detail_stat_chip"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="30 habs"
                            android:textColor="#68707A"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/montoBLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detailRowB"
                    android:layout_marginTop="12dp"
                    android:text="Monto total:"
                    android:textColor="#183447"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/montoBLabel"
                    android:layout_marginStart="104dp"
                    android:text="310,000 USD"
                    android:textColor="#4F5962"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sepBLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/montoBLabel"
                    android:layout_marginTop="14dp"
                    android:text="SEPARACIÓN:"
                    android:textColor="#9A7817"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/sepBLabel"
                    android:layout_marginStart="104dp"
                    android:text="1,400 USD"
                    android:textColor="#4F5962"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_project"
                android:padding="14dp">

                <TextView
                    android:id="@+id/detailTitleC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo C"
                    android:textColor="#153448"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/admin_detail_status_red"
                    android:gravity="center"
                    android:text="NO DISPONIBLE"
                    android:textColor="#B31515"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/detailRowC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detailTitleC"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_admin_ruler" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/admin_detail_stat_chip"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="60 m²"
                            android:textColor="#68707A"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_admin_bed" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/admin_detail_stat_chip"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="40 habs"
                            android:textColor="#68707A"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/montoCLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detailRowC"
                    android:layout_marginTop="12dp"
                    android:text="Monto total:"
                    android:textColor="#183447"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/montoCLabel"
                    android:layout_marginStart="104dp"
                    android:text="310,000 USD"
                    android:textColor="#4F5962"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sepCLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/montoCLabel"
                    android:layout_marginTop="14dp"
                    android:text="SEPARACIÓN:"
                    android:textColor="#9A7817"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/sepCLabel"
                    android:layout_marginStart="104dp"
                    android:text="1,400 USD"
                    android:textColor="#4F5962"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="AMENIDADES"
                android:textColor="#082D42"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/admin_detail_amenity_bg"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_admin_laptop" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Coworking"
                        android:textColor="#32373C"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/admin_detail_amenity_bg"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_admin_pool" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
