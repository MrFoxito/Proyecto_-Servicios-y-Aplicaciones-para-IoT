<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sa_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#F6F7F9"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnDownloadLogs"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/sa_fab_logs_bg"
                android:contentDescription="descargar"
                android:src="@android:drawable/stat_sys_download_done"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Logs"
                android:textColor="#072B41"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivHeaderProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:src="@drawable/sa_profile_square" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/layoutLogsUserFilter"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/sa_logs_filter_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#7A828E" />

                    <EditText
                        android:id="@+id/editLogsUserFilterValue"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Filtrar por Usuario"
                        android:textColor="#072B41"
                        android:textColorHint="#7A828E"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/sa_logs_filter_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:id="@+id/layoutLogsDateFilter">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        app:tint="#7A828E" />

                    <TextView
                        android:id="@+id/textLogsDateFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Seleccionar Fecha"
                        android:textColor="#7A828E"
                        android:textSize="14sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipLogsAll"
                            android:layout_width="104dp"
                            android:layout_height="36dp"
                            android:background="@drawable/sa_chip_active"
                            android:gravity="center"
                            android:text="TODOS"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipLogsCritical"
                            android:layout_width="104dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/sa_chip_inactive"
                            android:gravity="center"
                            android:text="CRITICOS"
                            android:textColor="#6F6A63"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipLogsAlerts"
                            android:layout_width="104dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/sa_chip_inactive"
                            android:gravity="center"
                            android:text="ALERTAS"
                            android:textColor="#6F6A63"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                            
                        <TextView
                            android:id="@+id/chipLogsInfo"
                            android:layout_width="104dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/sa_chip_inactive"
                            android:gravity="center"
                            android:text="INFO"
                            android:textColor="#6F6A63"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                            
                        <TextView
                            android:id="@+id/chipLogsSuccess"
                            android:layout_width="104dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/sa_chip_inactive"
                            android:gravity="center"
                            android:text="ÉXITO"
                            android:textColor="#6F6A63"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerLogs"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="14dp" />

            </LinearLayout>
        </LinearLayout>

        <include layout="@layout/view_superadmin_bottom_nav" />
    </LinearLayout>

</FrameLayout>

