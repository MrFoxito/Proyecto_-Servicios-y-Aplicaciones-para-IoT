<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_24">

    <LinearLayout
        android:id="@+id/notificationApprovalCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/user_notification_card_bg"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/user_notification_icon_box_bg">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_user_check_circle"
                    app:tint="@color/app_brand_navy_2" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNotificationItemTime"
                style="@style/TextRoleCaption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/app_text_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNotificationItemTitle"
            style="@style/TextRoleH2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:textColor="@color/app_text_primary" />

        <TextView
            android:id="@+id/tvNotificationItemBody"
            style="@style/TextRoleParagraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotificationItemCta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_20"
            android:background="@drawable/user_detail_primary_button_bg"
            android:backgroundTint="@android:color/transparent"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:rippleColor="#22000000"
            app:strokeWidth="0dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notificationVisitCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/notificationTimeline"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:gravity="top|center_horizontal"
            android:orientation="vertical">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/user_unread_dot_bg" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:background="@color/app_separator" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNotificationItemTitleVisit"
                    style="@style/TextRoleH2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/app_text_primary" />

                <TextView
                    android:id="@+id/tvNotificationItemTimeVisit"
                    style="@style/TextRoleCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/app_text_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotificationItemBodyVisit"
                style="@style/TextRoleParagraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12" />

            <FrameLayout
                android:id="@+id/notificationItemCityPhoto"
                android:layout_width="match_parent"
                android:layout_height="194dp"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/user_notification_city_photo" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
