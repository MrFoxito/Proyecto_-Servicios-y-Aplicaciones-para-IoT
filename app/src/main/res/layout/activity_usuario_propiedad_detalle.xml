<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/propertyDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Galería de imágenes estilo Airbnb -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpPropertyGallery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Botón de regreso flotante circular -->
                <ImageButton
                    android:id="@+id/btnBackPropertyDetail"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/user_back_button_bg"
                    android:contentDescription="@string/cd_back"
                    android:padding="10dp"
                    android:src="@drawable/ic_user_back"
                    android:elevation="6dp"
                    app:tint="@color/app_text_primary" />

                <!-- ID invisible para que Java siga encontrando el título del top bar -->
                <TextView
                    android:id="@+id/tvPropertyTopBarTitle"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Contador de fotos estilo Airbnb -->
                <TextView
                    android:id="@+id/tvImageCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/user_image_counter_bg"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="@font/manrope_bold"
                    android:visibility="gone"
                    android:elevation="4dp" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="24dp"
                android:paddingTop="24dp"
                android:paddingRight="24dp"
                android:paddingBottom="100dp"> <!-- margen inferior para que no tape la barra sticky -->

                <!-- Estado del proyecto (Badge) -->
                <TextView
                    android:id="@+id/propertyHeroBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/user_badge_bg"
                    android:backgroundTint="@color/app_brand_navy"
                    android:paddingLeft="12dp"
                    android:paddingTop="4dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/property_badge_pre_sale"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:fontFamily="@font/manrope_bold" />

                <!-- Nombre del Proyecto -->
                <TextView
                    android:id="@+id/propertyHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/property_title"
                    android:textColor="@color/app_text_primary"
                    android:textSize="24sp"
                    android:fontFamily="@font/manrope_extrabold" />

                <!-- Subtítulo / Tagline -->
                <TextView
                    android:id="@+id/propertyHeroSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/property_subtitle"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/manrope_medium" />

                <!-- Separador delgado -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/app_separator" />

                <!-- Ubicación y Entrega (Flat, sin tarjeta) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubicación"
                            android:textColor="@color/app_text_muted"
                            android:textSize="11sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/propertyLocationText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/property_location"
                            android:textColor="@color/app_text_primary"
                            android:textSize="16sp"
                            android:fontFamily="@font/manrope_bold" />

                        <TextView
                            android:id="@+id/propertyDistrictText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/property_location_detail"
                            android:textColor="@color/app_text_secondary"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_medium" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:background="@color/app_separator"
                        android:layout_marginHorizontal="16dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Entrega"
                            android:textColor="@color/app_text_muted"
                            android:textSize="11sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/propertyEtaText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/property_eta"
                            android:textColor="@color/app_text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Separador delgado -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/app_separator" />

                <TextView
                    style="@style/TextRoleH2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/property_features_title"
                    android:textColor="@color/app_text_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/user_detail_map_card_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:id="@+id/ivAmenityOneIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user_activity"
                            app:tint="@color/app_text_primary" />

                        <TextView
                            android:id="@+id/tvAmenityOneTitle"
                            style="@style/TextRoleListTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/feature_gym_title" />

                        <TextView
                            android:id="@+id/tvAmenityOneDescription"
                            style="@style/TextRoleCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/feature_gym_desc"
                            android:textColor="@color/app_text_muted" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/space_12"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/user_detail_map_card_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:id="@+id/ivAmenityTwoIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user_explore"
                            app:tint="@color/app_text_primary" />

                        <TextView
                            android:id="@+id/tvAmenityTwoTitle"
                            style="@style/TextRoleListTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/feature_pool_title" />

                        <TextView
                            android:id="@+id/tvAmenityTwoDescription"
                            style="@style/TextRoleCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/feature_pool_desc"
                            android:textColor="@color/app_text_muted" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/user_detail_map_card_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:id="@+id/ivAmenityThreeIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user_chat"
                            app:tint="@color/app_text_primary" />

                        <TextView
                            android:id="@+id/tvAmenityThreeTitle"
                            style="@style/TextRoleListTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/feature_cowork_title" />

                        <TextView
                            android:id="@+id/tvAmenityThreeDescription"
                            style="@style/TextRoleCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/feature_cowork_desc"
                            android:textColor="@color/app_text_muted" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/space_12"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/user_detail_map_card_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:id="@+id/ivAmenityFourIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user_shield"
                            app:tint="@color/app_text_primary" />

                        <TextView
                            android:id="@+id/tvAmenityFourTitle"
                            style="@style/TextRoleListTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/feature_security_title" />

                        <TextView
                            android:id="@+id/tvAmenityFourDescription"
                            style="@style/TextRoleCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/feature_security_desc"
                            android:textColor="@color/app_text_muted" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/user_surface_card_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <TextView
                        style="@style/TextRoleH2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/property_about_title"
                        android:textColor="@color/app_text_primary" />

                    <TextView
                        android:id="@+id/propertyAboutDescription"
                        style="@style/TextRoleParagraph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/property_about_desc"
                        android:textColor="@color/app_text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/propertyHighlightOne"
                            style="@style/TextRoleH3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/user_badge_bg"
                            android:gravity="center"
                            android:paddingLeft="@dimen/space_12"
                            android:paddingTop="@dimen/space_8"
                            android:paddingRight="@dimen/space_12"
                            android:paddingBottom="@dimen/space_8"
                            android:text="@string/property_certification"
                            android:textColor="@color/app_accent_gold" />

                        <Space
                            android:layout_width="@dimen/space_12"
                            android:layout_height="1dp" />

                        <TextView
                            android:id="@+id/propertyHighlightTwo"
                            style="@style/TextRoleH3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/user_badge_bg"
                            android:gravity="center"
                            android:paddingLeft="@dimen/space_12"
                            android:paddingTop="@dimen/space_8"
                            android:paddingRight="@dimen/space_12"
                            android:paddingBottom="@dimen/space_8"
                            android:text="@string/property_domotics"
                            android:textColor="@color/app_accent_gold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/user_detail_map_card_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/user_profile_icon_bg">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_user_location"
                                app:tint="@color/app_text_primary" />
                        </FrameLayout>

                        <TextView
                            style="@style/TextRoleH2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/space_12"
                            android:layout_weight="1"
                            android:text="@string/property_map_title"
                            android:textColor="@color/app_text_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/propertyMapSummary"
                        style="@style/TextRoleParagraph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/property_map_desc"
                        android:textColor="@color/app_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPropertyMapAction"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/control_height_md"
                        android:layout_marginTop="@dimen/space_16"
                        android:background="@drawable/user_detail_ghost_button_bg"
                        android:backgroundTint="@android:color/transparent"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:text="@string/property_map_cta"
                        android:textColor="@color/app_text_primary"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/radius_sm"
                        app:icon="@drawable/ic_user_explore"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/space_8"
                        app:iconTint="@color/app_text_primary"
                        app:rippleColor="#22000000"
                        app:strokeWidth="0dp" />
                </LinearLayout>

                <!-- Botón secundario: Separar Inmueble -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSepararInmueble"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:text="@string/property_separate_button"
                    android:textColor="@color/app_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/manrope_bold"
                    app:backgroundTint="@android:color/white"
                    app:cornerRadius="@dimen/radius_sm"
                    app:rippleColor="#11000000"
                    app:strokeColor="@color/app_button_outline"
                    app:strokeWidth="1dp" />

                <!-- Botón secundario: Contactar Asesor -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContactarAsesor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:text="@string/property_contact_advisor_button"
                    android:textColor="@color/app_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/manrope_bold"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="@dimen/radius_sm"
                    app:icon="@drawable/ic_user_chat"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_8"
                    app:iconTint="@color/app_text_primary"
                    app:rippleColor="#11000000"
                    app:strokeColor="@color/app_button_outline"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed actions: the temporary separation flow remains visible while the detail scrolls. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Retained as the remote price binding target used by existing detail flows. -->
        <TextView
            android:id="@+id/propertyPriceText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgendarCita"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/property_schedule_button"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_bold"
            app:backgroundTint="@color/app_brand_navy"
            app:cornerRadius="@dimen/radius_sm"
            app:rippleColor="#22FFFFFF"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSepararProyectoFijo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Separar proyecto"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_bold"
            app:backgroundTint="@color/app_brand_navy"
            app:cornerRadius="@dimen/radius_sm"
            app:rippleColor="#22FFFFFF"
            app:strokeWidth="0dp" />
    </LinearLayout>

</FrameLayout>
