<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/propertyDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:paddingLeft="@dimen/space_12"
                android:paddingTop="@dimen/space_8"
                android:paddingRight="@dimen/space_16"
                android:paddingBottom="@dimen/space_8">

                <ImageButton
                    android:id="@+id/btnBackPropertyDetail"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="@drawable/user_profile_icon_bg"
                    android:contentDescription="@string/cd_back"
                    android:padding="12dp"
                    android:src="@drawable/ic_user_back"
                    app:tint="@color/app_text_primary" />

                <TextView
                    android:id="@+id/tvPropertyTopBarTitle"
                    style="@style/TextRoleH2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_16"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/property_title"
                    android:textColor="@color/app_text_primary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/app_separator" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="288dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpPropertyGallery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvImageCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/user_detail_tag_gold_bg"
                    android:paddingLeft="8dp"
                    android:paddingTop="4dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:elevation="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/user_detail_hero_overlay" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/space_20"
                    android:paddingRight="@dimen/space_20"
                    android:paddingBottom="@dimen/space_20">

                    <TextView
                        android:id="@+id/propertyHeroBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/user_detail_tag_gold_bg"
                        android:paddingLeft="@dimen/space_12"
                        android:paddingTop="4dp"
                        android:paddingRight="@dimen/space_12"
                        android:paddingBottom="4dp"
                        android:text="@string/property_badge_pre_sale"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/propertyHeroTitle"
                        style="@style/TextRoleH1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/property_title"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/propertyHeroSubtitle"
                        style="@style/TextRoleParagraph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:maxLines="2"
                        android:text="@string/property_subtitle"
                        android:textColor="#E9EDF2" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/space_16"
                android:paddingTop="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:paddingBottom="@dimen/space_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/user_surface_card_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <TextView
                        style="@style/TextRoleH3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/property_label_price"
                        android:textColor="@color/app_text_muted" />

                    <TextView
                        android:id="@+id/propertyPriceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/property_price"
                        android:textColor="@color/app_text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_16"
                        android:background="@color/app_separator" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextRoleH3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/property_label_location"
                                android:textColor="@color/app_text_muted" />

                            <TextView
                                android:id="@+id/propertyLocationText"
                                style="@style/TextRoleH2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:text="@string/property_location" />

                            <TextView
                                android:id="@+id/propertyDistrictText"
                                style="@style/TextRoleCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/property_location_detail" />
                        </LinearLayout>

                        <Space
                            android:layout_width="@dimen/space_16"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="104dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextRoleH3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/property_label_eta"
                                android:textColor="@color/app_text_muted" />

                            <TextView
                                android:id="@+id/propertyEtaText"
                                style="@style/TextRoleH2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:text="@string/property_eta" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/TextRoleH2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/property_features_title"
                    android:textColor="@color/app_text_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/user_detail_map_card_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:id="@+id/ivAmenityOneIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user_activity"
                            app:tint="@color/app_text_primary" />

                        <TextView
                            android:id="@+id/tvAmenityOneTitle"
                            style="@style/TextRoleListTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/feature_gym_title" />

                        <TextView
                            android:id="@+id/tvAmenityOneDescription"
                            style="@style/TextRoleCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/feature_gym_desc"
                            android:textColor="@color/app_text_muted" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/space_12"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/user_detail_map_card_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:id="@+id/ivAmenityTwoIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user_explore"
                            app:tint="@color/app_text_primary" />

                        <TextView
                            android:id="@+id/tvAmenityTwoTitle"
                            style="@style/TextRoleListTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/feature_pool_title" />

                        <TextView
                            android:id="@+id/tvAmenityTwoDescription"
                            style="@style/TextRoleCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/feature_pool_desc"
                            android:textColor="@color/app_text_muted" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/user_detail_map_card_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:id="@+id/ivAmenityThreeIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user_chat"
                            app:tint="@color/app_text_primary" />

                        <TextView
                            android:id="@+id/tvAmenityThreeTitle"
                            style="@style/TextRoleListTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/feature_cowork_title" />

                        <TextView
                            android:id="@+id/tvAmenityThreeDescription"
                            style="@style/TextRoleCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/feature_cowork_desc"
                            android:textColor="@color/app_text_muted" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/space_12"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/user_detail_map_card_bg"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:id="@+id/ivAmenityFourIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user_shield"
                            app:tint="@color/app_text_primary" />

                        <TextView
                            android:id="@+id/tvAmenityFourTitle"
                            style="@style/TextRoleListTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/feature_security_title" />

                        <TextView
                            android:id="@+id/tvAmenityFourDescription"
                            style="@style/TextRoleCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/feature_security_desc"
                            android:textColor="@color/app_text_muted" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/user_surface_card_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <TextView
                        style="@style/TextRoleH2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/property_about_title"
                        android:textColor="@color/app_text_primary" />

                    <TextView
                        android:id="@+id/propertyAboutDescription"
                        style="@style/TextRoleParagraph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/property_about_desc"
                        android:textColor="@color/app_text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/propertyHighlightOne"
                            style="@style/TextRoleH3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/user_badge_bg"
                            android:gravity="center"
                            android:paddingLeft="@dimen/space_12"
                            android:paddingTop="@dimen/space_8"
                            android:paddingRight="@dimen/space_12"
                            android:paddingBottom="@dimen/space_8"
                            android:text="@string/property_certification"
                            android:textColor="@color/app_accent_gold" />

                        <Space
                            android:layout_width="@dimen/space_12"
                            android:layout_height="1dp" />

                        <TextView
                            android:id="@+id/propertyHighlightTwo"
                            style="@style/TextRoleH3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/user_badge_bg"
                            android:gravity="center"
                            android:paddingLeft="@dimen/space_12"
                            android:paddingTop="@dimen/space_8"
                            android:paddingRight="@dimen/space_12"
                            android:paddingBottom="@dimen/space_8"
                            android:text="@string/property_domotics"
                            android:textColor="@color/app_accent_gold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/user_detail_map_card_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/user_profile_icon_bg">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_user_location"
                                app:tint="@color/app_text_primary" />
                        </FrameLayout>

                        <TextView
                            style="@style/TextRoleH2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/space_12"
                            android:layout_weight="1"
                            android:text="@string/property_map_title"
                            android:textColor="@color/app_text_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/propertyMapSummary"
                        style="@style/TextRoleParagraph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/property_map_desc"
                        android:textColor="@color/app_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPropertyMapAction"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/control_height_md"
                        android:layout_marginTop="@dimen/space_16"
                        android:background="@drawable/user_detail_ghost_button_bg"
                        android:backgroundTint="@android:color/transparent"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:text="@string/property_map_cta"
                        android:textColor="@color/app_text_primary"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/radius_sm"
                        app:icon="@drawable/ic_user_explore"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/space_8"
                        app:iconTint="@color/app_text_primary"
                        app:rippleColor="#22000000"
                        app:strokeWidth="0dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgendarCita"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_height_md"
                    android:layout_marginTop="@dimen/space_28"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:text="@string/property_schedule_button"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/app_brand_navy_2"
                    app:cornerRadius="@dimen/radius_sm"
                    app:rippleColor="#22000000"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSepararInmueble"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_height_md"
                    android:layout_marginTop="@dimen/space_12"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:text="@string/property_separate_button"
                    android:textColor="@color/app_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/white"
                    app:cornerRadius="@dimen/radius_sm"
                    app:rippleColor="#22000000"
                    app:strokeColor="@color/app_button_outline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContactarAsesor"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_height_md"
                    android:layout_marginTop="@dimen/space_12"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:text="@string/property_contact_advisor_button"
                    android:textColor="@color/app_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="@dimen/radius_sm"
                    app:icon="@drawable/ic_user_chat"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_8"
                    app:iconTint="@color/app_text_primary"
                    app:rippleColor="#22000000"
                    app:strokeColor="@color/app_button_outline"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
