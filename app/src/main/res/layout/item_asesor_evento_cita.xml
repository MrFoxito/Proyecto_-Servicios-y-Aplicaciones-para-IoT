<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/as_card"
    android:elevation="2dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <View
        android:id="@+id/indicadorColor"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="#9AA3AF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtEventoTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Título del evento"
                android:textColor="#0B1D2A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEventoFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha"
                android:textColor="#9AA3AF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtEventoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Detalle del evento"
            android:textColor="#68727B"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
