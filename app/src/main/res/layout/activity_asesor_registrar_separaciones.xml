<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Botón confirm fijo al fondo -->
    <LinearLayout
        android:id="@+id/panelConfirmar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/as_bottom_action_shadow"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/btnConfirmarRegistroSeparacion"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/as_button_dark"
            android:gravity="center"
            android:text="Confirmar Registro de Separación  ›"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCancelarRegistroSeparacion"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Cancelar y volver"
            android:textColor="#68727B"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Botón back -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_as_back"
        app:tint="#0B1D2A" />

    <!-- Contenido scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/panelConfirmar"
        android:layout_below="@id/btnBack"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NUEVA SEPARACIÓN"
                android:textColor="#6E737A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Registrar Separación"
                android:textColor="#0B1D2A"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Complete los detalles para formalizar la intención de compra. Esta acción notificará de inmediato al equipo administrativo."
                android:textColor="#5F6972"
                android:textSize="13sp" />

            <!-- ─── BANNER: origen desde cita (GONE por defecto) ─── -->
            <LinearLayout
                android:id="@+id/bannerCitaVinculada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#1A2F7E00"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <!-- Franja de color lateral -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#C8A800" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ORIGINADO DESDE CITA"
                        android:textColor="#8F7E00"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtBannerCitaDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Autocompletado."
                        android:textColor="#4E5961"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/as_chip_light"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="CITA"
                    android:textColor="#746D4A"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Campo oculto: ID de la cita vinculada -->
            <TextView
                android:id="@+id/txtSepCitaId"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- ─── SECCIÓN: Proyecto inmobiliario ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="PROYECTO INMOBILIARIO"
                android:textColor="#8C9298"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Fila proyecto: campo + badge cita -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/as_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <AutoCompleteTextView
                    android:id="@+id/txtSepProyecto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Buscar proyecto por nombre o ID..."
                    android:textColor="#2F383F"
                    android:textColorHint="#A0A6AC"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/badgeSepProyectoVinculado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/as_status_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="CITA"
                    android:textColor="#0A2D3A"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ─── SECCIÓN: Cliente ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="CLIENTE ASOCIADO"
                android:textColor="#8C9298"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Campo cliente -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/as_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <AutoCompleteTextView
                    android:id="@+id/txtSepCliente"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Buscar cliente por nombre o ID..."
                    android:textColor="#2F383F"
                    android:textColorHint="#A0A6AC"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/badgeSepClienteVinculado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/as_status_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="CITA"
                    android:textColor="#0A2D3A"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ─── SECCIÓN: Monto ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="MONTO DE SEPARACIÓN PROPUESTO"
                android:textColor="#8C9298"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/as_input_white"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$ "
                        android:textColor="#2D363D"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txtSepMonto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textColor="#2D363D"
                        android:textColorHint="#D5D8DB"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSepMontoSugerido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Monto sugerido para este proyecto: $15,000.00"
                    android:textColor="#68727B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ─── SECCIÓN: Forma de pago ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="FORMA DE PAGO"
                android:textColor="#8C9298"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipPagoEfectivo"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/as_chip_dark"
                    android:gravity="center"
                    android:text="Efectivo"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipPagoTransferencia"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/as_chip_light"
                    android:gravity="center"
                    android:text="Transferencia"
                    android:textColor="#746D4A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipPagoFinanciamiento"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/as_chip_light"
                    android:gravity="center"
                    android:text="Financiamiento"
                    android:textColor="#746D4A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ─── SECCIÓN: Observaciones ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="OBSERVACIONES"
                android:textColor="#8C9298"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtSepObservaciones"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/as_input_white"
                android:gravity="top"
                android:hint="Ej: Cliente requiere escrituración en 30 días..."
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="#2D363D"
                android:textColorHint="#A0A6AC"
                android:textSize="13sp" />

            <!-- ─── Aviso de procesamiento ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/as_card_soft"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#8F7E00" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aviso de Procesamiento"
                        android:textColor="#0B1D2A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Al enviar este formulario se generará una alerta de prioridad alta para el departamento administrativo y se bloqueará temporalmente la unidad por 24 horas."
                        android:textColor="#4E5961"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
