<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <ImageButton
                android:id="@+id/btnBackRegister"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="back"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/app_text_primary" />

            <TextView
                style="@style/TextRoleH2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="Registro" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <TextView
                style="@style/TextRoleH3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALTA DE CUENTA"
                android:textColor="@color/app_accent_gold" />

            <TextView
                style="@style/TextRoleH1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Crear cuenta" />

            <TextView
                style="@style/TextRoleParagraph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Completa tus datos para acceder a inmuebles exclusivos."
                android:textColor="@color/app_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/auth_card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/TextRoleH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOMBRE COMPLETO"
                    android:textColor="@color/app_text_muted" />

                <EditText
                    android:id="@+id/inputFullName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@android:color/transparent"
                    android:hint="Ej. Julian Casablancas"
                    android:inputType="textPersonName"
                    android:textAppearance="@style/TextRoleParagraph"
                    android:textColor="@color/app_text_primary"
                    android:textColorHint="@color/app_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/app_separator" />

                <TextView
                    style="@style/TextRoleH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="CORREO ELECTRONICO"
                    android:textColor="@color/app_text_muted" />

                <EditText
                    android:id="@+id/inputRegisterEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@android:color/transparent"
                    android:hint="julian@editorialestate.com"
                    android:inputType="textEmailAddress"
                    android:textAppearance="@style/TextRoleParagraph"
                    android:textColor="@color/app_text_primary"
                    android:textColorHint="@color/app_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/app_separator" />

                <TextView
                    style="@style/TextRoleH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="TELEFONO"
                    android:textColor="@color/app_text_muted" />

                <EditText
                    android:id="@+id/inputPhone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@android:color/transparent"
                    android:hint="+34 600 000 000"
                    android:inputType="phone"
                    android:textAppearance="@style/TextRoleParagraph"
                    android:textColor="@color/app_text_primary"
                    android:textColorHint="@color/app_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/app_separator" />

                <TextView
                    style="@style/TextRoleH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="CONTRASENA"
                    android:textColor="@color/app_text_muted" />

                <EditText
                    android:id="@+id/inputRegisterPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@android:color/transparent"
                    android:hint="************"
                    android:inputType="textPassword"
                    android:textAppearance="@style/TextRoleParagraph"
                    android:textColor="@color/app_text_primary"
                    android:textColorHint="@color/app_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/app_separator" />

                <TextView
                    style="@style/TextRoleH3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="CONFIRMAR CONTRASENA"
                    android:textColor="@color/app_text_muted" />

                <EditText
                    android:id="@+id/inputConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@android:color/transparent"
                    android:hint="************"
                    android:inputType="textPassword"
                    android:textAppearance="@style/TextRoleParagraph"
                    android:textColor="@color/app_text_primary"
                    android:textColorHint="@color/app_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/app_separator" />
            </LinearLayout>

            <Button
                android:id="@+id/btnRegisterAccount"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/auth_primary_button_bg"
                android:backgroundTint="@null"
                android:text="Registrar cuenta"
                android:textAllCaps="false"
                android:textAppearance="@style/TextTypeBodyMd"
                android:textColor="@color/app_nav_active_text" />

            <TextView
                style="@style/TextRoleParagraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Ya tienes una cuenta?"
                android:textColor="@color/app_text_secondary" />

            <TextView
                android:id="@+id/txtOpenLogin"
                style="@style/TextRoleCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="4dp"
                android:text="Inicia sesion"
                android:textColor="@color/app_accent_gold" />

            <TextView
                style="@style/TextRoleCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="AL REGISTRARTE, ACEPTAS TERMINOS Y POLITICA DE PRIVACIDAD."
                android:textColor="@color/app_text_muted" />
        </LinearLayout>
    </LinearLayout>

</ScrollView>
