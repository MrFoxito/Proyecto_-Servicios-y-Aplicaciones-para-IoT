<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/btnBackRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_as_back"
            android:padding="12dp"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            style="@style/TextRoleH1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear cuenta"
            android:textColor="@color/app_text_primary" />

        <TextView
            style="@style/TextRoleParagraph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completa tus datos para comenzar"
            android:textColor="@color/app_text_secondary"
            android:layout_marginTop="8dp" />

        <!-- Tarjeta con campos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/app_bg"
            app:strokeWidth="0dp"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Nombres -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="Nombres"
                    app:boxStrokeColor="@color/app_separator"
                    app:hintTextColor="@color/app_text_muted"
                    android:textColorHint="@color/app_text_soft"
                    app:startIconTint="@color/app_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputNombres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textAppearance="@style/TextRoleParagraph"
                        android:textColor="@color/app_text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Apellidos -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="Apellidos"
                    app:boxStrokeColor="@color/app_separator"
                    app:hintTextColor="@color/app_text_muted"
                    android:textColorHint="@color/app_text_soft"
                    app:startIconTint="@color/app_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputApellidos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textAppearance="@style/TextRoleParagraph"
                        android:textColor="@color/app_text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Correo -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="Correo electrónico"
                    app:boxStrokeColor="@color/app_separator"
                    app:hintTextColor="@color/app_text_muted"
                    android:textColorHint="@color/app_text_soft"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/app_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRegisterEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textAppearance="@style/TextRoleParagraph"
                        android:textColor="@color/app_text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Teléfono -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="Teléfono"
                    app:boxStrokeColor="@color/app_separator"
                    app:hintTextColor="@color/app_text_muted"
                    android:textColorHint="@color/app_text_soft"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="@color/app_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textAppearance="@style/TextRoleParagraph"
                        android:textColor="@color/app_text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Tipo de cuenta"
                    android:textAppearance="@style/TextRoleH3"
                    android:textColor="@color/app_text_primary" />

                <RadioGroup
                    android:id="@+id/inputAccountType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioClient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Cliente"
                        android:textColor="@color/app_text_primary" />

                    <RadioButton
                        android:id="@+id/radioAdvisor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Solicitar registro como asesor"
                        android:textColor="@color/app_text_primary" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRequestedCompany"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Inmobiliaria a la que postulas"
                    android:visibility="gone"
                    app:boxStrokeColor="@color/app_separator"
                    app:hintTextColor="@color/app_text_muted">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/inputRequestedCompany"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textAppearance="@style/TextRoleParagraph"
                        android:textColor="@color/app_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Contraseña -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="Contraseña"
                    app:boxStrokeColor="@color/app_separator"
                    app:hintTextColor="@color/app_text_muted"
                    android:textColorHint="@color/app_text_soft"
                    app:endIconMode="password_toggle"
                    app:startIconTint="@color/app_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRegisterPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textAppearance="@style/TextRoleParagraph"
                        android:textColor="@color/app_text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirmar contraseña -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="Confirmar contraseña"
                    app:boxStrokeColor="@color/app_separator"
                    app:hintTextColor="@color/app_text_muted"
                    android:textColorHint="@color/app_text_soft"
                    app:endIconMode="password_toggle"
                    app:startIconTint="@color/app_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textAppearance="@style/TextRoleParagraph"
                        android:textColor="@color/app_text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón Registrarse -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegisterAccount"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/app_brand_navy"
                    android:text="Registrarse"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextTypeBodyMd" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Enlace a login -->
        <TextView
            style="@style/TextRoleParagraph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="¿Ya tienes cuenta?"
            android:textColor="@color/app_text_secondary" />

        <TextView
            android:id="@+id/txtOpenLogin"
            style="@style/TextRoleH3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Inicia sesión"
            android:textColor="@color/app_accent_gold" />

        <TextView
            style="@style/TextRoleCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Al registrarte, aceptas los Términos y Política de Privacidad"
            android:textColor="@color/app_text_muted" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
