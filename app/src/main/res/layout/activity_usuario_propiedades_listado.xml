<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userPropertiesListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <ScrollView
        android:id="@+id/userPropertiesListScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="108dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/userPropertiesListContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/space_24"
            android:paddingTop="52dp"
            android:paddingRight="@dimen/space_24"
            android:paddingBottom="@dimen/space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBackPropertiesList"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="@drawable/user_profile_icon_bg"
                    android:contentDescription="@string/cd_back"
                    android:padding="@dimen/space_12"
                    android:src="@drawable/ic_user_back"
                    android:tint="@color/app_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextRoleH1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/property_list_title" />

                    <TextView
                        style="@style/TextRoleParagraph"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/property_list_subtitle" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_lg"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/user_search_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16">

                <ImageView
                    android:layout_width="@dimen/icon_search"
                    android:layout_height="@dimen/icon_search"
                    android:contentDescription="@string/cd_search"
                    android:src="@drawable/ic_user_search"
                    android:tint="@color/app_text_soft" />

                <TextView
                    style="@style/TextRoleParagraph"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="@string/property_list_search_hint"
                    android:textColor="@color/app_text_soft" />

                <ImageView
                    android:layout_width="@dimen/icon_nav"
                    android:layout_height="@dimen/icon_nav"
                    android:contentDescription="@string/cd_filter"
                    android:src="@drawable/ic_user_filter"
                    android:tint="@color/app_text_soft" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenMapFromList"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_md"
                android:layout_marginTop="@dimen/space_20"
                android:background="@drawable/user_detail_secondary_button_bg"
                android:backgroundTint="@android:color/transparent"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:text="@string/property_list_open_map"
                android:textColor="@color/app_text_primary"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="@dimen/radius_sm"
                app:icon="@drawable/ic_user_location"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_8"
                app:iconTint="@color/app_text_primary"
                app:rippleColor="#22000000"
                app:strokeWidth="0dp" />

            <LinearLayout
                android:id="@+id/propertyListCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/user_surface_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/list_card_min_height"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/list_card_image_size"
                    android:layout_height="@dimen/list_card_image_size"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_featured_property"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_featured_house" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextRoleH3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/property_list_label_featured"
                        android:textColor="@color/app_accent_gold" />

                    <TextView
                        style="@style/TextRoleH2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_featured_property" />

                    <TextView
                        style="@style/TextRoleCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_featured_location" />

                    <TextView
                        style="@style/TextRoleH2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_featured_price"
                        android:textColor="@color/app_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/propertyListCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/user_surface_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/list_card_min_height"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/list_card_image_size"
                    android:layout_height="@dimen/list_card_image_size"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_popular_property_1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_popular_1" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextRoleH3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_popular_label_1"
                        android:textColor="@color/app_accent_gold" />

                    <TextView
                        style="@style/TextRoleH2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_popular_property_1" />

                    <TextView
                        style="@style/TextRoleCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/property_list_location_one" />

                    <TextView
                        style="@style/TextRoleH2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_popular_price_1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/propertyListCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/user_surface_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/list_card_min_height"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/list_card_image_size"
                    android:layout_height="@dimen/list_card_image_size"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_popular_property_2"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_popular_2" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextRoleH3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_popular_label_2"
                        android:textColor="@color/app_accent_gold" />

                    <TextView
                        style="@style/TextRoleH2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_popular_property_2" />

                    <TextView
                        style="@style/TextRoleCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/property_list_location_two" />

                    <TextView
                        style="@style/TextRoleH2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_popular_price_2" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/propertyListCard4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/user_surface_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/list_card_min_height"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/list_card_image_size"
                    android:layout_height="@dimen/list_card_image_size"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/property_list_title_four"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_featured_house" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextRoleH3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/property_list_label_new"
                        android:textColor="@color/app_accent_gold" />

                    <TextView
                        style="@style/TextRoleH2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/property_list_title_four" />

                    <TextView
                        style="@style/TextRoleCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/property_list_location_four" />

                    <TextView
                        style="@style/TextRoleH2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/property_list_price_four" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/userBottomNavInclude"
        layout="@layout/view_usuario_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>
