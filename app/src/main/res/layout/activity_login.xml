<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="36dp"
        android:paddingRight="24dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/TextRoleH3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCESO PRIVADO"
            android:textColor="@color/app_accent_gold" />

        <TextView
            style="@style/TextRoleH1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Bienvenido de nuevo" />

        <TextView
            style="@style/TextRoleParagraph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Accede con tu correo para continuar en la red editorial."
            android:textColor="@color/app_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/auth_card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/TextRoleH3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORREO ELECTRONICO"
                android:textColor="@color/app_text_muted" />

            <EditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/auth_input_bg"
                android:hint="nombre@editorial.com"
                android:inputType="textEmailAddress"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textAppearance="@style/TextRoleParagraph"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_soft" />

            <TextView
                style="@style/TextRoleH3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="CONTRASENA"
                android:textColor="@color/app_text_muted" />

            <EditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/auth_input_bg"
                android:hint="********"
                android:inputType="textPassword"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textAppearance="@style/TextRoleParagraph"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_soft" />

            <Button
                android:id="@+id/btnLogin"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/auth_primary_button_bg"
                android:backgroundTint="@null"
                android:text="Iniciar sesion"
                android:textAllCaps="false"
                android:textAppearance="@style/TextTypeBodyMd"
                android:textColor="@color/app_nav_active_text" />

            <TextView
                android:id="@+id/txtForgotPassword"
                style="@style/TextRoleCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="Olvide mi contrasena"
                android:textColor="@color/app_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/app_separator" />

            <TextView
                style="@style/TextRoleCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:text="o"
                android:textColor="@color/app_text_muted" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/app_separator" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnOpenRegister"
            style="@style/TextRoleH3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:text="Registrarse"
            android:textColor="@color/app_accent_gold" />

        <TextView
            style="@style/TextRoleCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="AL CONTINUAR, ACEPTAS TERMINOS Y POLITICA DE PRIVACIDAD."
            android:textColor="@color/app_text_muted" />

    </LinearLayout>

</ScrollView>
