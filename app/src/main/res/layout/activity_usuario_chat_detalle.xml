<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/space_16"
            android:paddingTop="@dimen/space_12"
            android:paddingRight="@dimen/space_16"
            android:paddingBottom="@dimen/space_12">

            <ImageButton
                android:id="@+id/btnBackChatDetail"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="@drawable/user_profile_icon_bg"
                android:contentDescription="@string/cd_back"
                android:padding="12dp"
                android:src="@drawable/ic_user_back"
                android:tint="@color/app_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextRoleH2"
                    android:id="@+id/tvChatContactName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_row_1_name"
                    android:textColor="@color/app_text_primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/user_unread_dot_bg"
                        android:contentDescription="@string/cd_status_dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/space_8"
                        android:letterSpacing="0.16"
                        android:text="@string/chat_detail_status_online"
                        android:textColor="@color/app_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/chat_row_1_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sa_profile_admin" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <ScrollView
            android:id="@+id/chatDetailScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="126dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chatMessagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/space_16"
                android:paddingTop="@dimen/space_20"
                android:paddingRight="@dimen/space_16"
                android:paddingBottom="@dimen/space_20">

                <TextView
                    android:layout_width="106dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/user_chat_day_chip_bg"
                    android:gravity="center"
                    android:text="@string/chat_detail_day"
                    android:textColor="#61584E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:background="@drawable/user_surface_card_bg"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_16">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="186dp"
                        android:background="@drawable/user_chat_property_photo">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/user_detail_hero_overlay" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:orientation="vertical"
                            android:padding="@dimen/space_16">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/user_detail_tag_gold_bg"
                                android:paddingLeft="@dimen/space_12"
                                android:paddingTop="4dp"
                                android:paddingRight="@dimen/space_12"
                                android:paddingBottom="4dp"
                                android:text="@string/chat_detail_badge"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvChatPropertyTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:text="@string/chat_detail_property_title"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="@dimen/space_16"
                        android:paddingRight="@dimen/space_16">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvChatPropertyLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chat_detail_property_location"
                                android:textColor="@color/app_text_secondary"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tvChatPropertyPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:text="@string/chat_detail_property_price"
                                android:textColor="@color/app_text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChatPropertyDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:background="@drawable/user_detail_secondary_button_bg"
                            android:backgroundTint="@android:color/transparent"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"
                            android:minWidth="128dp"
                            android:text="@string/chat_detail_property_cta"
                            android:textColor="@color/app_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            app:rippleColor="#22000000"
                            app:strokeWidth="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_28"
                    android:layout_marginRight="92dp"
                    android:background="@drawable/user_chat_message_in_bg"
                    android:padding="@dimen/space_16"
                    android:text="@string/chat_detail_message_in"
                    android:textColor="@color/app_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/chat_detail_time_1"
                    android:textColor="@color/app_text_soft"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="92dp"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/user_chat_message_out_bg"
                    android:padding="@dimen/space_16"
                    android:text="@string/chat_detail_message_out"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/chat_detail_time_2"
                    android:textColor="@color/app_text_soft"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/user_chat_pager_dot_bg" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="@dimen/space_8"
                        android:background="@drawable/user_chat_pager_dot_bg" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="@dimen/space_8"
                        android:background="@drawable/user_chat_pager_dot_bg" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chatComposerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/app_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/space_16"
        android:paddingTop="@dimen/space_12"
        android:paddingRight="@dimen/space_16"
        android:paddingBottom="@dimen/space_12">

        <ImageButton
            android:id="@+id/btnAttachChat"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/user_chat_compose_plus_bg"
            android:contentDescription="@string/cd_attachment"
            android:padding="18dp"
            android:src="@drawable/ic_user_gallery"
            android:tint="@color/app_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginLeft="@dimen/space_12"
            android:layout_weight="1"
            android:background="@drawable/user_chat_compose_input_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/space_16"
            android:paddingRight="@dimen/space_16">

            <EditText
                android:id="@+id/chatMessageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/chat_detail_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:padding="0dp"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_soft"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/cd_attachment"
                android:src="@drawable/ic_user_gallery"
                android:tint="@color/app_text_soft" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSendChatMessage"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginLeft="@dimen/space_12"
            android:background="@drawable/user_chat_compose_send_bg"
            android:contentDescription="@string/cd_send_message"
            android:padding="16dp"
            android:src="@drawable/ic_chat_send"
            android:tint="@color/white" />
    </LinearLayout>

</FrameLayout>
