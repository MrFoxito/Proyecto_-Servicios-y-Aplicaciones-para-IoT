<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/as_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Fila superior: fecha + hora + badge cierre -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtHcFecha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="18 ABR · 09:30 AM"
            android:textColor="#9A8A6E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Badge estado -->
        <TextView
            android:id="@+id/txtHcStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/as_status_green"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="CONFIRMADA"
            android:textColor="#0A2D3A"
            android:textSize="8sp"
            android:textStyle="bold" />

        <!-- Badge cierre (solo visible si hasCierre) -->
        <TextView
            android:id="@+id/badgeCierre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/as_dot_gold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="CIERRE"
            android:textColor="#0B1D2A"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Nombre de la propiedad -->
    <TextView
        android:id="@+id/txtHcPropiedad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Penthouse El Cielo"
        android:textColor="#0B1D2A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Cliente -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtHcCliente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Inversiones Valero"
            android:textColor="#63707A"
            android:textSize="12sp" />

        <!-- Proyecto chip -->
        <TextView
            android:id="@+id/txtHcProyecto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/as_chip_light"
            android:maxWidth="120dp"
            android:ellipsize="end"
            android:lines="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Inmobiliaria Horizonte"
            android:textColor="#746D4A"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divisor sutil -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#F0F1F3" />

    <!-- Fila inferior: ícono tipo acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtHcAccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ver detalle"
            android:textColor="#9AA3AF"
            android:textSize="10sp" />

        <ImageButton
            android:id="@+id/btnHcDetalle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_as_back"
            android:rotation="180"
            app:tint="#9AA3AF"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

    </LinearLayout>

</LinearLayout>
