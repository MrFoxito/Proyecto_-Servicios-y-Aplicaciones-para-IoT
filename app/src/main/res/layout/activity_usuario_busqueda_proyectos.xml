<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/projectSearchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/explore_bg">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProjectSearchResults"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingLeft="16dp"
        android:paddingTop="82dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp"
        android:scrollbars="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnBackProjectSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/explore_header_icon_bg"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_user_back"
            app:tint="@color/explore_text_primary" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProjectSearchBar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:transitionName="project_search_bar"
            app:cardBackgroundColor="@color/explore_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/explore_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="10dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/cd_search"
                    android:src="@drawable/ic_user_search"
                    app:tint="@color/explore_text_primary" />

                <EditText
                    android:id="@+id/inputProjectSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/manrope_semibold"
                    android:hint="Buscar proyectos"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/explore_text_primary"
                    android:textColorHint="@color/explore_text_secondary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnClearProjectSearch"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Limpiar búsqueda"
                    android:padding="10dp"
                    android:src="@drawable/ic_as_close"
                    app:tint="@color/explore_text_primary"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</FrameLayout>
