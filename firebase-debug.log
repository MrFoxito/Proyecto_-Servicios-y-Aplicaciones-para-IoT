[debug] [2026-06-21T00:19:00.925Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/iot-g3-c3fa2/rulesets {"name":"projects/iot-g3-c3fa2/rulesets/0d4afe99-aac0-470e-9b18-74c1e3b9c8bc","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function currentUser() {\r\n      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));\r\n    }\r\n\r\n    function role() {\r\n      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))\r\n        ? currentUser().data.rol\r\n        : '';\r\n    }\r\n\r\n    function isSuperadmin() {\r\n      return role() == 'superadmin';\r\n    }\r\n\r\n    function isAdmin() {\r\n      return role() == 'admin';\r\n    }\r\n\r\n    function isAsesor() {\r\n      return role() == 'asesor';\r\n    }\r\n\r\n    function isCliente() {\r\n      return role() == 'cliente';\r\n    }\r\n\r\n    function canManageBusinessData() {\r\n      return isAdmin() || isSuperadmin();\r\n    }\r\n\r\n    match /usuarios/{uid} {\r\n      allow read: if signedIn() && (\r\n        request.auth.uid == uid ||\r\n        isSuperadmin() ||\r\n        (resource.data.rol == 'asesor' && resource.data.estado == 'activo')\r\n      );\r\n      allow update: if signedIn() && (request.auth.uid == uid || isSuperadmin());\r\n      allow create: if signedIn() && request.auth.uid == uid;\r\n      allow delete: if isSuperadmin();\r\n    }\r\n\r\n    match /proyectos/{projectId} {\r\n      allow read: if signedIn();\r\n      allow create, update: if isAdmin() || isSuperadmin();\r\n      allow delete: if isSuperadmin();\r\n    }\r\n\r\n    match /proyectos_tipologias/{typologyId} {\n      allow read: if signedIn();\n      allow create, update: if isAdmin() || isSuperadmin();\n      allow delete: if isAdmin() || isSuperadmin();\n    }\n\r\n    match /proyectos_amenidades/{amenityId} {\n      allow read: if signedIn();\n      allow create, update: if isAdmin() || isSuperadmin();\n      allow delete: if isAdmin() || isSuperadmin();\n    }\n\r\n    match /proyectos_imagenes/{imageId} {\n      allow read: if signedIn();\n      allow create, update: if isAdmin() || isSuperadmin();\n      allow delete: if isAdmin() || isSuperadmin();\n    }\n\r\n    match /empresas/{adminId} {\r\n      allow read: if signedIn();\r\n      allow create, update: if signedIn() && (request.auth.uid == adminId || isSuperadmin());\r\n      allow delete: if isSuperadmin();\r\n    }\r\n\r\n    match /asignaciones/{assignmentId} {\r\n      allow read: if signedIn();\r\n      allow create, update: if isAdmin() || isSuperadmin();\r\n      allow delete: if isSuperadmin();\r\n    }\r\n\r\n    match /asesor_disponibilidad/{asesorId} {\r\n      allow read: if signedIn();\r\n      allow create, update: if signedIn() && (\r\n        request.auth.uid == asesorId ||\r\n        canManageBusinessData()\r\n      );\r\n      allow delete: if isSuperadmin();\r\n    }\r\n\r\n    match /proyectos_disponibilidad/{projectId} {\r\n      allow read: if signedIn();\r\n      allow create, update: if canManageBusinessData();\r\n      allow delete: if isSuperadmin();\r\n    }\r\n\r\n    match /solicitudes_asesor/{requestId} {\r\n      allow read: if isAdmin() || isAsesor() || isSuperadmin();\r\n      allow create: if isAsesor() || isSuperadmin();\r\n      allow update: if isAdmin() || isSuperadmin();\r\n      allow delete: if isSuperadmin();\r\n    }\r\n\r\n    match /citas/{citaId} {\r\n      allow read: if signedIn() && (\r\n        request.auth.uid == resource.data.clienteId ||\r\n        request.auth.uid == resource.data.asesorId ||\r\n        canManageBusinessData()\r\n      );\r\n      allow create: if signedIn() && (\r\n        request.auth.uid == request.resource.data.clienteId ||\r\n        request.auth.uid == request.resource.data.asesorId ||\r\n        canManageBusinessData()\r\n      );\r\n      allow update: if signedIn() && (\r\n        request.auth.uid == resource.data.clienteId ||\r\n        request.auth.uid == resource.data.asesorId ||\r\n        canManageBusinessData()\r\n      );\r\n      allow delete: if isSuperadmin();\r\n    }\r\n\r\n    match /citas_slots/{slotId} {\r\n      allow read: if signedIn();\r\n      allow create: if signedIn()\r\n        && !exists(/databases/$(database)/documents/citas_slots/$(slotId))\r\n        && (\r\n          request.auth.uid == request.resource.data.clienteId ||\r\n          request.auth.uid in request.resource.data.clientIds ||\r\n          request.auth.uid == request.resource.data.asesorId ||\r\n          canManageBusinessData()\r\n        );\r\n      allow update: if signedIn() && (\r\n        request.auth.uid == resource.data.clienteId ||\r\n        request.auth.uid in resource.data.clientIds ||\r\n        request.auth.uid in request.resource.data.clientIds ||\r\n        request.auth.uid == resource.data.asesorId ||\r\n        canManageBusinessData()\r\n      );\r\n      allow delete: if signedIn() && (\r\n        request.auth.uid == resource.data.clienteId ||\r\n        request.auth.uid in resource.data.clientIds ||\r\n        request.auth.uid == resource.data.asesorId ||\r\n        canManageBusinessData()\r\n      );\r\n    }\r\n\r\n    match /eventos_cita/{eventId} {\r\n      allow read: if signedIn();\r\n      allow create: if signedIn() && (\r\n        request.auth.uid == request.resource.data.clienteId ||\r\n        request.auth.uid == request.resource.data.asesorId ||\r\n        canManageBusinessData()\r\n      );\r\n      allow update, delete: if isAdmin() || isSuperadmin();\r\n    }\r\n\r\n    match /separaciones/{separacionId} {\r\n      allow read: if signedIn() && (\r\n        request.auth.uid == resource.data.clienteId ||\r\n        request.auth.uid == resource.data.asesorId ||\r\n        canManageBusinessData()\r\n      );\r\n      allow create: if signedIn() && (\r\n        request.auth.uid == request.resource.data.clienteId ||\r\n        request.auth.uid == request.resource.data.asesorId ||\r\n        canManageBusinessData()\r\n      );\r\n      allow update: if signedIn() && (\r\n        request.auth.uid == resource.data.clienteId ||\r\n        request.auth.uid == resource.data.asesorId ||\r\n        canManageBusinessData()\r\n      );\r\n      allow delete: if isSuperadmin();\r\n    }\r\n\r\n    match /conversaciones/{conversationId} {\r\n      allow read, update: if signedIn() && request.auth.uid in resource.data.participantUids;\r\n      allow create: if signedIn() && request.auth.uid in request.resource.data.participantUids;\r\n      allow delete: if isSuperadmin();\r\n    }\r\n\r\n    match /mensajes/{messageId} {\r\n      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;\r\n      allow create: if signedIn()\r\n        && request.auth.uid == request.resource.data.senderUid\r\n        && request.auth.uid in request.resource.data.participantUids;\r\n      allow update, delete: if isSuperadmin();\r\n    }\r\n\r\n    match /notificaciones/{notificationId} {\n      allow read: if signedIn() && (\r\n        resource.data.recipientId == request.auth.uid ||\r\n        resource.data.uid == request.auth.uid ||\r\n        isAdmin() ||\r\n        isSuperadmin()\r\n      );\r\n      allow create, update: if signedIn();\n      allow delete: if signedIn() && (\n        isSuperadmin() ||\n        resource.data.recipientId == request.auth.uid ||\n        resource.data.uid == request.auth.uid\n      );\n    }\n\r\n    match /tramites/{tramiteId} {\r\n      allow read, create, update: if isCliente() || isAsesor() || isAdmin() || isSuperadmin();\r\n      allow delete: if isSuperadmin();\r\n    }\r\n\r\n    match /historial_usuario/{historyId} {\r\n      allow read, create: if signedIn();\r\n      allow update, delete: if isSuperadmin();\r\n    }\r\n\r\n    match /resenas/{reviewId} {\r\n      allow read: if signedIn();\r\n      allow create: if isCliente();\r\n      allow update, delete: if isAdmin() || isSuperadmin();\r\n    }\r\n\r\n    match /logs_sistema/{logId} {\r\n      allow read, write: if isSuperadmin();\r\n    }\r\n\r\n    match /app_meta/{docId} {\r\n      allow read: if signedIn();\r\n      allow write: if isAdmin() || isSuperadmin();\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-06-21T00:19:01.305903Z","metadata":{"services":["cloud.firestore"]}}
